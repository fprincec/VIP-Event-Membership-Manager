<!DOCTYPE html> <!-- This line tells the browser that this file uses HTML5. -->
<html lang="en"> <!-- This line starts the HTML document and sets the language to English. -->
<head> <!-- This line starts the head section, which stores page settings and links. -->
    <meta charset="UTF-8"> <!-- This line allows the page to display common characters correctly. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- This line helps the page scale correctly on different screen sizes. -->
    <title>VIP Event & Membership Manager</title> <!-- This line sets the browser tab title. -->
    <link rel="stylesheet" href="/styles.css"> <!-- This line connects the CSS file from the public folder. -->
</head> <!-- This line ends the head section. -->
<body> <!-- This line starts the visible body of the web page. -->
    <header class="site-header"> <!-- This line creates the top header area of the website. -->
        <h1>VIP Event & Membership Manager</h1> <!-- This line displays the main project title. -->
        <p>Manage members, events, and registrations</p> <!-- This line displays a short description under the title. -->
    </header> <!-- This line ends the header area. -->

    <nav class="navbar"> <!-- This line creates the navigation bar. -->
        <a href="/">Dashboard</a> <!-- This line creates a link to the dashboard page. -->
        <a href="/members">Members</a> <!-- This line creates a link to the members page. -->
        <a href="/events">Events</a> <!-- This line creates a link to the events page. -->
        <a href="/registrations">Registrations</a> <!-- This line creates a link to the registrations page. -->
    </nav> <!-- This line ends the navigation bar. -->

    <main class="container"> <!-- This line starts the main content container for each page. -->